# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. For production, use a hosted Postgres
# (Vercel Postgres, Neon, or Supabase all have a free tier, no card needed
# for Neon/Supabase). For local dev, see DEPLOY.md for a one-command
# Homebrew Postgres setup.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Field-level encryption key for sensitive Passport data (license numbers,
# and uploaded license/background-check files).
# Generate with: openssl rand -hex 32
# Losing this key makes existing encrypted data unrecoverable - store it in
# your host's secret manager, not in source control.
ENCRYPTION_KEY=""

# Outbound email (email verification, endorsement requests). Free tier at
# resend.com, no card required. Leave unset to fall back to dev mode: the
# app logs the email and shows the link in the UI instead of sending it.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Project Mary <onboarding@resend.dev>"

# File uploads (license scans, background-check documents). Create a Blob
# store in your Vercel project dashboard - Storage tab - to get this token.
# Leave unset to fall back to encrypted local disk storage (dev only, not
# durable across serverless deploys).
BLOB_READ_WRITE_TOKEN=""
